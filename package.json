{
	"name": "slovko",
	"private": true,
	"version": "0.7.654",
	"type": "module",
	"engines": {
		"node": ">=22.12.0"
	},
	"scripts": {
		"dev": "vite dev",
		"test": "vitest run",
		"build": "vite build && node scripts/generate-sitemap.mjs",
		"preview": "vite preview",
		"prepare": "husky",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:build": "node scripts/check-build.mjs",
		"check:bundle": "node scripts/check-bundle.mjs",
		"check:rules": "node scripts/firebase-cli.mjs emulators:exec --project demo-slovko --only firestore,database,auth \"node scripts/check-rules.mjs\"",
		"emulators": "node scripts/firebase-cli.mjs emulators:start --project demo-slovko --only firestore,database,auth",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "eslint .",
		"format": "prettier --write .",
		"deploy": "npm run build && npx gh-pages -d build -t true",
		"fix:b2": "node scripts/maintenance/fix_b2_gaps_from_other_levels.js",
		"check:missing": "node scripts/analysis/find_missing_all.js",
		"check:missing:full": "node scripts/analysis/find_missing_comprehensive.js",
		"check:duplicates": "node scripts/analysis/check_duplicates.js",
		"analyze:duplicates:global": "node scripts/analysis/check_global_duplicates.js",
		"check:transcriptions": "node scripts/analysis/check_transcriptions.js",
		"analyze:vocab": "node scripts/analysis/vocab_analysis.js",
		"i18n:check": "node scripts/maintenance/check_translations.js",
		"i18n:add:pl": "node scripts/maintenance/add_pl_translations.js",
		"cleanup:monitor": "node scripts/maintenance/cleanup_monitor.cjs",
		"find:placeholders": "node scripts/analysis/find_placeholders.js",
		"analyze:polysemy": "node scripts/analysis/analyze_polysemy.js",
		"analyze:cross": "node scripts/analysis/audit_cross_language.js",
		"sync:full": "node scripts/maintenance/full_ssot_sync.js",
		"bump": "node scripts/bump-version.js",
		"test:unit": "vitest run",
		"test:e2e": "playwright test"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.13.0",
		"@playwright/test": "^1.62.1",
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"eslint": "^9.39.2",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.0",
		"glob": "^13.0.6",
		"husky": "^9.1.7",
		"js-yaml": "^5.3.0",
		"prettier": "^3.9.6",
		"prettier-plugin-svelte": "^3.4.1",
		"svelte": "^5.56.10",
		"svelte-check": "^4.7.6",
		"svelte-eslint-parser": "^1.4.1",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.68.0",
		"vite": "^7.3.1",
		"vite-plugin-pwa": "^1.3.0",
		"vitest": "^4.1.11"
	},
	"dependencies": {
		"firebase": "^12.18.0",
		"lucide-svelte": "^0.563.0",
		"svelte-i18n": "^4.0.1",
		"zod": "^4.4.3"
	},
	"overrides": {
		"cookie": "^0.7.2",
		"esbuild": ">=0.25.0",
		"serialize-javascript": "^7.0.3"
	}
}
