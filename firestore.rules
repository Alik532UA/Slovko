rules_version = '2';

/*
 * Правила доступу до Firestore.
 *
 * ЦЬОГО ФАЙЛУ РАНІШЕ НЕ ІСНУВАЛО. Ні `firestore.rules`, ні `database.rules.json`,
 * ні `firebase.json` — усе, що захищало базу, жило лише в консолі Firebase: не
 * переглянути, не звірити з кодом, не побачити в історії змін, не перевірити
 * гейтом. Два сусідні проєкти того самого автора мали в консолі
 * `allow read, write: if true`, тож апріорна оцінка була погана
 * (CLOUD-DATABASE-v8 § 2.1).
 *
 * ЄДИНА МЕЖА БЕЗПЕКИ. Публічний конфіг Firebase за побудовою лежить у бандлі,
 * тож адресу бази знає кожен, хто відкрив сайт. Усе, що робить із базою клієнт,
 * може зробити будь-хто тим самим SDK із консолі браузера — без нашого UI й без
 * нашої валідації. Отже між відвідувачем і чужими даними стоїть лише цей файл.
 *
 * ПЕРЕВІРЯЮТЬСЯ ГЕЙТОМ: `npm run check:rules` піднімає емулятор і проганяє два
 * набори випадків — «застосунок мусить це вміти» й «сторонній не мусить цього
 * могти». Правила «дозволити все» валять другий набір, «заборонити все» —
 * перший, тож зелений результат неможливий випадково.
 *
 * ВИКЛАДАННЯ. `firebase deploy --only firestore:rules,database`. Поки в
 * PROJECT-CONTEXT.md стоїть «не звірений», вважати викладеним НЕ можна: гейт
 * перевіряє файл, а не консоль.
 */
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    /*
     * Особисті дані користувача: налаштування, прогрес, плейлісти, історія.
     * Читає й пише ЛИШЕ власник — тут немає жодного сценарію, у якому чужий
     * прогрес потрібен комусь іншому.
     */
    match /users/{uid} {
      allow read, write: if isOwner(uid);

      /** Історія по днях: `users/{uid}/history/{YYYY-MM-DD}`. */
      match /history/{day} {
        allow read, write: if isOwner(uid);
      }

      /** Плейлісти (схема v2, винесені з поля документа в підколекцію). */
      match /playlists_v2/{playlistId} {
        allow read, write: if isOwner(uid);
      }

      /**
       * Прогрес по словах, схема v3: `users/{uid}/words/{shard}`.
       *
       * Винесений із поля `progress.words` головного документа з тієї самої
       * причини, що й плейлісти: мапа росла з кожним вивченим словом і впиралася
       * б у межу 1 МіБ, а кожна синхронізація перезаписувала б її цілком заради
       * одного лічильника (CLOUD-DATABASE-v8 § 6.2).
       */
      match /words/{shard} {
        allow read, write: if isOwner(uid);
      }

      /**
       * НА КОГО підписаний власник документа.
       *
       * Пише лише він сам. Видалити може ще й той, на кого підписані: це
       * «прибери мене зі своїх підписок», і без цього дозволу
       * `FriendsService.removeFollower` не працює.
       */
      match /following/{targetUid} {
        allow read: if signedIn();
        allow create, update: if isOwner(uid);
        allow delete: if isOwner(uid) || isOwner(targetUid);
      }

      /**
       * ХТО підписаний на власника документа.
       *
       * Дзеркально: запис створює сам підписник (ідентифікатор документа — його
       * uid), а видалити може і він, і власник — це «видали цього підписника».
       */
      match /followers/{followerUid} {
        allow read: if signedIn();
        allow create, update: if isOwner(followerUid);
        allow delete: if isOwner(followerUid) || isOwner(uid);
      }

      /** Решта під-шляхів користувача — заборонено. */
      match /{other=**} {
        allow read, write: if false;
      }
    }

    /*
     * ПУБЛІЧНИЙ ПРОФІЛЬ. Тут лежить рівно те, що людина погодилася показати.
     *
     * ЧИТАЄ ЛИШЕ АВТОРИЗОВАНИЙ — і `get` тут не виняток.
     *
     * Спершу тут стояло `allow get: if true`: здавалося, що читання одного
     * профілю за ідентифікатором нікому не шкодить. Живий зонд показав інше —
     * `GET /documents/profiles` без жодного токена повертав документи, бо REST
     * перелічує колекцію поштучними читаннями. Тобто «нешкідливий get»
     * відкривав усю колекцію стороннім.
     *
     * Застосунок від звуження не втрачає нічого: він входить анонімно ще до
     * першого читання, тож авторизований сеанс є завжди.
     *
     * ПЕРЕЛІЧУВАТИ можна лише порціями — на переліку стоять і пошук, і таблиця
     * лідерів.
     *
     * Доти приватність трималася виключно на умові `where("privacy.showInSearch",
     * "==", true)` у клієнтському запиті — а це фільтр, а не контроль доступу:
     * той самий запит без `where` повертає все (CLOUD-DATABASE-v8 § 4.4).
     *
     * Самої пошти тут більше немає — лише її SHA-256. Правил рівня поля у
     * Firestore не існує, тож дозвіл читати документ означав дозвіл читати
     * адресу (§ 4.5).
     */
    match /profiles/{uid} {
      allow get: if signedIn();
      allow list: if signedIn() && request.query.limit <= 50;
      allow write: if isOwner(uid);
    }

    /*
     * ЧОМУ ПЕРЕЛІК ПРОФІЛІВ УСЕ-ТАКИ ДОЗВОЛЕНИЙ — і чому це не поступка.
     *
     * Спокуса написати `allow list: if resource.data.privacy.showInSearch == true`
     * велика: Firestore тоді змусив би кожен запит нести цей фільтр. Але тут є
     * ДРУГИЙ запит до тієї самої колекції — таблиця лідерів, — і він сортує за
     * результатом, а не за згодою на пошук. Таке правило зламало б її повністю.
     *
     * Тому межа проведена там, де вона справді тримає: у колекції немає нічого
     * приватного. Пошта звідси прибрана й лежить хешем; решта — ім'я, аватар і
     * результат — публічні за призначенням, бо саме їх показує таблиця лідерів.
     * Захист приватного тут не в правилі читання, а в тому, що приватного тут
     * НЕМАЄ (CLOUD-DATABASE-v8 § 4.5).
     *
     * Що правило все-таки тримає: неавторизований не перелічить нікого, і жоден
     * запит не витягне більше за 50 документів за раз.
     */

    /*
     * ВІДГУКИ Й СКАРГИ НА СЛОВО. Форма відкрита кожному, хто натиснув кнопку.
     *
     * ЦИХ ПРАВИЛ РАНІШЕ НЕ БУЛО ВЗАГАЛІ, і це не «недостатньо звужено» — це
     * зламана функція. `FeedbackService` пише в `feedback/{category}/messages` і
     * `feedback_anonymous/{category}/messages`, правил для них не існувало, тож
     * обидва шляхи забирав catch-all `if false`: і форма відгуку, і скарга на
     * переклад слова відмовляли з `permission-denied`. Гірше того, код ловив цей
     * код і кидав `AUTH_REQUIRED` — тобто прогалина в правилах показувалася
     * користувачеві як проблема з його сеансом (CLOUD-DATABASE-v8 § 2.3).
     *
     * ЧОМУ ГЕЙТ ЦЬОГО НЕ БАЧИВ. § 3.3 вимагає випадок на кожну колекцію,
     * ЗГАДАНУ У ПРАВИЛАХ. Колекції, якої в правилах немає, це не стосується
     * взагалі — і саме цю прогалину закриває § 3.5: перелік випадків будується
     * зі шляхів, у які пише КОД. Інваріант у `src/cloud-database.test.ts` тепер
     * так і робить.
     *
     * ДВІ ГІЛКИ, А НЕ ОДНА. Гість пише у `feedback_anonymous`, людина з акаунтом
     * — у `feedback`; префікс `dev_` додає збірка в режимі розробки. Правило те
     * саме для всіх чотирьох, і воно перелічене явно: `{root}` як вільна змінна
     * означала б «будь-яка колекція першого рівня», тобто дірку розміром з базу.
     *
     * МЕЖІ (§ 12.1). Створення відкрите й для неавторизованого — вимога входу
     * відрізала б саме тих відгуків, які найцінніші. Тому обсяг тримають інші
     * три речі: перелік ключів, перелік категорій і довжина кожного тексту. Без
     * них це була б точка, у яку будь-хто в інтернеті дописує документи зі
     * швидкістю мережі, і платив би за них не він.
     *
     * ЧИТАННЯ ЗАКРИТЕ. У записі є `user.uid`, `user.email` і `userAgent`, тож
     * відкрите читання зробило б із відгуків перелік користувачів. Дивляться їх
     * із консолі.
     */
    match /feedback/{category}/messages/{messageId} {
      allow create: if validFeedback(category);
      allow read, update, delete: if false;
    }
    match /feedback_anonymous/{category}/messages/{messageId} {
      allow create: if validFeedback(category);
      allow read, update, delete: if false;
    }
    match /dev_feedback/{category}/messages/{messageId} {
      allow create: if validFeedback(category);
      allow read, update, delete: if false;
    }
    match /dev_feedback_anonymous/{category}/messages/{messageId} {
      allow create: if validFeedback(category);
      allow read, update, delete: if false;
    }

    /**
     * Форма відгуку: категорія з переліку, ключі з переліку, тексти з межею.
     *
     * `word_error` — окрема категорія скарги на переклад; решта три приходять із
     * форми відгуку (`FeedbackCategory`).
     */
    function validFeedback(category) {
      return category in ['bug', 'improvement', 'contact', 'word_error']
             && request.resource.data.keys().hasOnly([
                  'title', 'message', 'status', 'isGuestReport', 'context', 'user', 'timestamp',
                  'wordKey', 'errorType', 'comment', 'sourceTranslation', 'targetTranslation'
                ])
             && (!('message' in request.resource.data)
                 || request.resource.data.message.size() <= 4000)
             && (!('comment' in request.resource.data)
                 || request.resource.data.comment.size() <= 4000)
             && (!('title' in request.resource.data)
                 || request.resource.data.title == null
                 || request.resource.data.title.size() <= 200);
    }

    /*
     * Журнал подій застосунку. Пише клієнт, читає лише консоль.
     *
     * `create` і тільки `create`: запис, який можна змінити або видалити, — це
     * не журнал. Читання закрите: у записах є `uid` і `userAgent`, тобто
     * відкрите читання зробило б із журналу перелік користувачів.
     */
    match /system_logs/{logId} {
      allow create: if signedIn()
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.keys().hasOnly(['timestamp', 'uid', 'action', 'details', 'userAgent']);
      allow read, update, delete: if false;
    }

    /*
     * Усе інше — заборонено. Саме цей блок і закриває головну дірку: без нього
     * чужа колекція заводиться одним запитом із DevTools.
     */
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
